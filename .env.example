# === DATABASE ===
# Railway автоматически подставит DATABASE_URL при подключении PostgreSQL сервиса
DATABASE_URL=postgresql://user:password@host:5432/railway

# === AUTH ===
# Минимум 32 символа, случайная строка
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-for-aes-256-gcm

# === ADMIN (используется при первом seed) ===
ADMIN_EMAIL=admin@rsu4udata.com
ADMIN_PASSWORD=your-strong-admin-password

# === KOMMO OAuth ===
KOMMO_CLIENT_ID=
KOMMO_CLIENT_SECRET=
KOMMO_REDIRECT_URI=https://rsu4udata.com/api/integrations/kommo/callback

# === FACEBOOK OAuth ===
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://rsu4udata.com/api/integrations/facebook/callback

# === APP ===
FRONTEND_URL=https://rsu4udata.com
NODE_ENV=production
PORT=3001
